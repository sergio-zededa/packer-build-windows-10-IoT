{
  "variables": {
    "workdir": "{{env `PWD`}}"
  },
  "builders": [
    {
      "type": "qemu",
      "vm_name": "windows-10-iot-uefi",
      "iso_url": "file://{{user `workdir`}}/en-us_windows_10_iot_enterprise_ltsc_2021_x64_dvd_257ad90f.iso",
      "iso_checksum": "none",
      "memory": 4096,
      "disk_image": false,
      "output_directory": "build/os-base-uefi",
      "accelerator": "kvm",
      "disk_size": 25600,
      "disk_interface": "ide",
      "format": "qcow2",
      "net_device": "e1000",
      "vnc_bind_address": "0.0.0.0",
      "boot_command": [
        "<spacebar><wait1><spacebar><wait1><spacebar><wait1><spacebar><wait1><spacebar><wait1><spacebar>"
      ],
      "boot_wait": "2s",
      "floppy_files": [
        "./floppy_win10iot_uefi/Autounattend.xml",
        "./floppy_win10iot_uefi/enable-winrm.cmd"
      ],
      "floppy_dirs": [
        "./floppy_win10iot_uefi"
      ],
      "communicator": "winrm",
      "winrm_username": "Administrator",
      "winrm_password": "PackerPassw0rd!",
      "winrm_port": 5985,
      "winrm_use_ssl": false,
      "winrm_insecure": true,
      "winrm_timeout": "6h",
      "shutdown_command": "powershell -ExecutionPolicy Bypass -Command \"if (-not (Test-Path 'C:\\Windows\\Temp\\cloudbase-init-conf\\Unattend.xml')) { throw 'Unattend.xml missing for Sysprep' }; Remove-Item -Recurse -Force 'C:\\Program Files\\Cloudbase Solutions\\Cloudbase-Init\\log\\*' -ErrorAction SilentlyContinue; & 'C:\\Windows\\System32\\Sysprep\\sysprep.exe' /generalize /shutdown /oobe /unattend:'C:\\Windows\\Temp\\cloudbase-init-conf\\Unattend.xml'\"",
      "shutdown_timeout": "2h",
      "headless": true,
      "qemuargs": [
        ["-machine", "q35,accel=kvm"],
        ["-cpu", "host"],
        ["-m", "4096M"],
        ["-smp", "2"],
        ["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"],
        ["-drive", "if=pflash,format=raw,file=/tmp/swtpm-win10iot/OVMF_VARS.fd"],
        ["-drive", "file={{user `workdir`}}/build/os-base-uefi/windows-10-iot-uefi,if=ide,cache=writeback,discard=ignore,format=qcow2,detect-zeroes=on"],
        ["-drive", "file={{user `workdir`}}/en-us_windows_10_iot_enterprise_ltsc_2021_x64_dvd_257ad90f.iso,media=cdrom,readonly=on"],
        ["-chardev", "socket,id=chrtpm,path=/tmp/swtpm-win10iot/swtpm-sock"],
        ["-tpmdev", "emulator,id=tpm0,chardev=chrtpm"],
        ["-device", "tpm-tis,tpmdev=tpm0"],
        ["-netdev", "user,id=rdp0,net=10.0.3.0/24,dhcpstart=10.0.3.15,hostfwd=tcp::3389-:3389,hostfwd=tcp::{{ .SSHHostPort }}-:5985"],
        ["-device", "e1000,netdev=rdp0"]
      ]
    }
  ],
  "provisioners": [
    {
      "type": "file",
      "source": "{{user `workdir`}}/Scripts/CloudBase-init-Install.ps1",
      "destination": "C:\\Windows\\Temp\\CloudBase-init-Install.ps1"
    },
    {
      "type": "file",
      "source": "{{user `workdir`}}/Scripts/prep-sysprep.ps1",
      "destination": "C:\\Windows\\Temp\\prep-sysprep.ps1"
    },
    {
      "type": "file",
      "source": "{{user `workdir`}}/Scripts/cloudbase-init-conf",
      "destination": "C:\\Windows\\Temp"
    },
    {
      "type": "file",
      "source": "{{user `workdir`}}/Scripts/mount_PV_disk.ps1",
      "destination": "C:\\Windows\\Temp\\mount_PV_disk.ps1"
    },
    {
      "type": "powershell",
      "inline": [
        "$url = 'http://192.168.1.9:8080/drivers/virtio-win.iso'",
        "$dest = 'C:\\Windows\\Temp\\virtio-win.iso'",
        "Invoke-WebRequest -Uri $url -OutFile $dest",
        "$mount = Mount-DiskImage -ImagePath $dest -PassThru",
        "$drive = ($mount | Get-Volume).DriveLetter + ':'",
        "$paths = @(",
        "  'viostor\\w10\\amd64',",
        "  'vioscsi\\w10\\amd64',",
        "  'NetKVM\\w10\\amd64',",
        "  'Balloon\\w10\\amd64',",
        "  'vioserial\\w10\\amd64'",
        ")",
        "foreach ($p in $paths) {",
        "  $full = Join-Path $drive $p",
        "  if (Test-Path $full) { pnputil /add-driver \"$full\\*.inf\" /subdirs /install }",
        "}",
        "$guestAgentCandidates = @(",
        "  (Join-Path $drive 'guest-agent\\qemu-ga-x86_64.msi'),",
        "  (Join-Path $drive 'qemu-ga-x86_64.msi')",
        ")",
        "$guestAgentMsi = $guestAgentCandidates | Where-Object { Test-Path $_ } | Select-Object -First 1",
        "if (-not $guestAgentMsi) { throw 'QEMU Guest Agent MSI not found on virtio-win ISO' }",
        "Start-Process -FilePath 'msiexec.exe' -ArgumentList @('/i', $guestAgentMsi, '/qn', '/norestart') -Wait -NoNewWindow",
        "Set-Service -Name 'QEMU-GA' -StartupType Automatic",
        "Start-Service -Name 'QEMU-GA'",
        "Dismount-DiskImage -ImagePath $dest"
      ]
    },
    {
      "type": "powershell",
      "inline": [
        "Set-ExecutionPolicy -ExecutionPolicy Bypass -Scope LocalMachine -Force",
        "& 'C:\\Windows\\Temp\\CloudBase-init-Install.ps1'",
        "& 'C:\\Windows\\Temp\\prep-sysprep.ps1'"
      ]
    },
    {
      "type": "powershell",
      "inline": [
        "New-Item -ItemType Directory -Path 'C:\\Program Files\\Cloudbase Solutions\\Cloudbase-Init\\LocalScripts' -Force -ErrorAction SilentlyContinue",
        "Copy-Item 'C:\\Windows\\Temp\\mount_PV_disk.ps1' 'C:\\Program Files\\Cloudbase Solutions\\Cloudbase-Init\\LocalScripts\\mount_PV_disk.ps1' -Force"
      ]
    },
    {
      "type": "file",
      "source": "{{user `workdir`}}/zpatch-agent-windows/ZededaAgent.ps1",
      "destination": "C:\\Windows\\Temp\\ZededaAgent.ps1"
    },
    {
      "type": "powershell",
      "inline": [
        "New-Item -ItemType Directory -Path 'C:\\Program Files\\ZededaAgent' -Force | Out-Null",
        "Copy-Item 'C:\\Windows\\Temp\\ZededaAgent.ps1' 'C:\\Program Files\\ZededaAgent\\ZededaAgent.ps1' -Force",
        "$action = New-ScheduledTaskAction -Execute 'powershell.exe' -Argument '-ExecutionPolicy Bypass -NoProfile -WindowStyle Hidden -File \"C:\\Program Files\\ZededaAgent\\ZededaAgent.ps1\"'",
        "$trigger = New-ScheduledTaskTrigger -AtStartup",
        "$principal = New-ScheduledTaskPrincipal -UserId 'NT AUTHORITY\\SYSTEM' -LogonType ServiceAccount -RunLevel Highest",
        "$settings = New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -ExecutionTimeLimit ([TimeSpan]::Zero) -StartWhenAvailable",
        "Register-ScheduledTask -TaskName 'ZededaUpdateAgent' -Description 'ZEDEDA patch agent - polls EVE-OS metadata server and applies patch envelopes' -Action $action -Trigger $trigger -Principal $principal -Settings $settings -Force"
      ]
    },
    {
      "type": "powershell",
      "inline": [
        "$action = New-ScheduledTaskAction -Execute 'powershell.exe' -Argument '-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File \"C:\\Program Files\\Cloudbase Solutions\\Cloudbase-Init\\LocalScripts\\mount_PV_disk.ps1\"'",
        "$trigger = New-ScheduledTaskTrigger -AtStartup",
        "$principal = New-ScheduledTaskPrincipal -UserID 'NT AUTHORITY\\SYSTEM' -RunLevel Highest",
        "$settings = New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -StartWhenAvailable",
        "Register-ScheduledTask -TaskName 'Mount Additional Disks' -Description 'Automatically mount additional disks on every boot' -Action $action -Trigger $trigger -Principal $principal -Settings $settings -Force"
      ]
    }
  ],
  "post-processors": [
    {
      "type": "shell-local",
      "inline": [
        "qemu-img convert -O qcow2 -c {{user `workdir`}}/build/os-base-uefi/windows-10-iot-uefi {{user `workdir`}}/build/os-base-uefi/windows-10-iot-uefi_compressed.qcow2",
        "rm -f {{user `workdir`}}/build/os-base-uefi/windows-10-iot-uefi"
      ]
    }
  ]
}
